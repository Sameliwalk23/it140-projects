START Move_Player

OUTPUT "Enter a direction (North, South, East, or West):"
INPUT direction

WHILE direction is not North AND
      direction is not South AND
      direction is not East AND
      direction is not West

    OUTPUT "Invalid direction. Try again."
    OUTPUT "Enter a direction (North, South, East, or West):"
    INPUT direction

END WHILE

IF direction is a valid exit from the current room THEN

    MOVE player to the next room

    OUTPUT "You entered a new room."

ELSE

    OUTPUT "You cannot go that way."

END IF

END Move_Player

